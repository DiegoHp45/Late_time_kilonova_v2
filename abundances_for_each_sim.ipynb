    "'''Animation simulations'''\n",
    "\n",
    "max_neutrons = 230\n",
    "max_protons = 120\n",
    "folder=select_abundance_folder(False, False, 'alpha and beta')\n",
    "files = os.listdir(folder)\n",
    "\n",
    "fig, ax = plt.subplots( figsize=(12,8))\n",
    "log_heatmap_matrix = np.zeros((max_protons+ 1,max_neutrons + 1))-30\n",
    "cax = ax.imshow(log_heatmap_matrix, origin='lower', cmap='plasma', aspect='auto',vmin=-30,vmax=np.log10(5.5e10),extent=[-0.5, max_neutrons+0.5,0-0.5, max_protons+0.5])\n",
    "\n",
    "def update(frame):\n",
    "    max_val=0\n",
    "    with open(os.path.join(folder, files[frame]), \"r\") as f:\n",
    "        # skip 3 header lines\n",
    "        for _ in range(3):\n",
    "            next(f)\n",
    "\n",
    "        for line in f:\n",
    "            values = list(map(float, line.split()))\n",
    "            if values[1]>max_val:\n",
    "                max_val=values[1]\n",
    "            #log_heatmap_matrix[int(values[1]), int(values[0])] = np.log10(values[3]+1e-30)#X\n",
    "    cax.set_data(log_heatmap_matrix)\n",
    "    return [cax], max_val\n",
    "    \n",
    "update(2)\n",
    "print(max_val)\n",
    "#Ani= animation.FuncAnimation(fig, update, frames=len(files), interval=200)\n",
    "#Ani.save(\"movie.mp4\")\n",
    "#plt.show()"
   ]
