    "import os\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.animation as animation\n",
    "#%matplotlib widget"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f9da9c5a",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def select_abundance_folder( Extra_teoretical:bool, T_eval_at_1GK:bool, minus:str):\n",
    "    if minus=='' and Extra_teoretical:\n",
    "        folder = \"Simulations\\Example_NSM_dyn_ejecta_rosswog_in_theoretical_500\"\n",
    "    elif minus=='' and not Extra_teoretical:\n",
    "        folder = \"Example_NSM_dyn_ejecta_rosswog_out_theoretical_500\"\n",
    "    elif minus=='' and T_eval_at_1GK:\n",
    "        folder = \"Not done yet\"\n",
    "    elif minus!='':\n",
    "        if minus == \"alpha and beta\":\n",
    "            folder = \"Example_NSM_dyn_ejecta_rosswog_500dias_sin_theoretical_beta_alpha_out\"\n",
    "        elif minus == \"only Q>0\":\n",
    "            folder = \"Example_NSM_dyn_ejecta_rosswog_500dias_sin_qneg_beta_alpha_out\"\n",
    "        else:\n",
    "            folder = \"Not done yet\"\n",
    "    return folder+'\\snaps'\n",
    "\n",
    "def read_abundance_file_A(file_path:str,folder:str):\n",
    "    A=[0]\n",
    "    abundances=[0]\n",
    "    with open(os.path.join(folder, file_path), \"r\") as f:\n",
    "    # skip 3 header lines\n",
    "        for _ in range(3):\n",
    "            next(f)\n",
    "\n",
    "        for line in f:\n",
    "            values = list(map(float, line.split()))\n",
    "            A_=values[0]+values[1]\n",
    "            if A_>A[-1]:\n",
    "                A.append(A_)\n",
    "                abundances.append(values[3])#X\n",
    "            else:\n",
    "                i=np.searchsorted(A, A_)\n",
    "                abundances[i]+=values[3]\n",
    "    return A, abundances\n",
    "\n",
    "\n",
    "def times_abundance(folder:str):\n",
    "    files=os.listdir(folder)\n",
    "    time=[]\n",
    "    for file in files:\n",
    "        time.append(float(np.loadtxt(os.path.join(folder, file), skiprows=1,max_rows=1, usecols=0)))\n",
    "    return time\n",
    "\n",
    "def abundances_at_some_time(folder:str, time:float):\n",
    "    files=os.listdir(folder)\n",
    "    times=times_abundance(folder)\n",
    "    i=np.searchsorted(times, time)\n",
    "    return read_abundance_file_A(files[i],folder)\n",
    "\n",
    "def general(Extra_teoretical:bool, T_eval_at_1GK:bool, minus:str, time:float):\n",
    "    folder=select_abundance_folder(Extra_teoretical, T_eval_at_1GK, minus)\n",
    "    #abundance=abundances_at_some_time(folder, time)\n",
    "    return read_abundance_file_A(os.listdir(folder)[np.searchsorted(times_abundance(folder), time)], folder)\n",
    "\n",
    "\n",
    "\n",
    "    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
