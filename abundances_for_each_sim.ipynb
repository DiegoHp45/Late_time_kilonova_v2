   "outputs": [],
   "source": [
    "A,abundances=general(False, False, 'alpha and beta', 8.64e6)\n",
    "A1,abundances1=general(False, False, 'only Q>0', 8.64e5)\n",
    "A2,abundances2=general(False, False, '', 8.64e6)\n",
    "A3,abundances3=general(True, False, '', 8.64e5)\n",
    "plt.figure(figsize=(12,6))\n",
    "plt.plot(A, abundances, label='with alpha and beta Exp')\n",
    "plt.plot(A1, abundances1, label='only Q>0')\n",
    "plt.plot(A2, abundances2, label='Reaclib ')\n",
    "plt.plot(A3, abundances3, label='Reaclib with theoretical')\n",
    "plt.xlabel('A')\n",
    "plt.ylabel('X(A)')\n",
    "plt.yscale('log')\n",
    "plt.ylim(1e-10,1)\n",
    "plt.legend(frameon=False)"
   ]
